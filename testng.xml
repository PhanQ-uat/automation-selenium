<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Browser Test Suite" parallel="tests" thread-count="2">
    
    <test name="Chrome Browser Test">
        <parameter name="browser" value="CHROME"/>
        <classes>
            <class name="org.example.BrowserLaunchTest"/>
        </classes>
    </test>
    
    <!-- Uncomment below to test Safari (need Safari remote automation enabled)
    <test name="Safari Browser Test">
        <parameter name="browser" value="SAFARI"/>
        <classes>
            <class name="org.example.BrowserLaunchTest"/>
        </classes>
    </test>
    -->
    
</suite>
